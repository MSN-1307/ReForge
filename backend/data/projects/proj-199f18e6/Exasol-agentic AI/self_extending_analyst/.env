# --- Exasol SaaS (Personal / free tier) ---
# From the web console (cloud.exasol.com) -> Databases -> your cluster ->
# "Connect via tools" (or the info icon) shows Connection string + Port + User name.
# EXASOL_DSN is "<connection string>:<port>" e.g. abc123.exasol.com:8563
EXASOL_DSN=w3qzgfbwp5f6hhomfpcspzoawe.clusters.exasol.com:8563 
EXASOL_USER=shankeshkumar05
# For Exasol SaaS, the "password" is a Personal Access Token (PAT), not an
# account password. Create one in the web console under your user menu ->
# Personal Access Token, then paste it here. It's shown only once.
EXASOL_PASSWORD=exa_pat_qU5KoSSjbhATI8PkIqVQpBBCtFES2iHpCgaevdCs1jrpWS
EXASOL_SCHEMA=AGENT_DEMO

# --- Model provider selection ---
# One of: gemini | ollama | groq
MODEL_PROVIDER=gemini

# --- Gemini ---
# Get your own key at https://aistudio.google.com/apikey
# There is no "Gemini 3.6" model at time of writing; check
# https://ai.google.dev/gemini-api/docs/models for the current name
# and put it here (e.g. gemini-2.5-flash, gemini-2.5-pro).
GEMINI_API_KEY=AQ.Ab8RN6Kisu05eY3iV5nXXkpmg-vLrWCGfe-uVn4ldcr4L4VNZQ
GEMINI_MODEL=gemini-3.6-flash

# --- Ollama (local fallback) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Groq (OpenAI-compatible cloud fallback) ---
GROQ_API_KEY=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
GROQ_MODEL=openai/gpt-oss-120b

# --- Agent behavior ---
MAX_UDF_REPAIR_ATTEMPTS=3
UDF_SANDBOX_TIMEOUT_SECONDS=10

{
  "manifest_version": 3,
  "name": "CodeSense AI",
  "version": "1.0",
  "description": "AI-powered coding assistant for LeetCode",
  "permissions": ["activeTab" ,"storage","sidePanel"],
  "action": {
    "default_popup": "index.html"
  },
  "side_panel": {
  "default_path": "index.html"
  },
  "background": {
  "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content.js"]
    }
  ]
}